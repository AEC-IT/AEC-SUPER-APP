{% load static %}{
  "name": "AEC HR",
  "short_name": "AEC HR",
  "description": "AEC Group HR — check in, leave, roster, payslips and announcements",
  "start_url": "/dashboard/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "icons": [
    {"src": "{% static 'pwa/icon-192.png' %}", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "{% static 'pwa/icon-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "shortcuts": [
    {"name": "Check in / out", "url": "/attendance/clock/"},
    {"name": "Apply leave", "url": "/leave/new/"},
    {"name": "My roster", "url": "/workforce/roster/"}
  ]
}
